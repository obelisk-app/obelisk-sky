{
  "name": "obelisk-sky",
  "private": true,
  "type": "module",
  "description": "sky.obelisk.ar — a 3D floating-island village animated by live public Obelisk chat",
  "scripts": {
    "dev:server": "tsx server/index.ts",
    "dev:client": "vite client",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.js",
    "build:client": "node scripts/build-guides.mjs && vite build client --outDir ../dist/client --emptyOutDir",
    "build": "npm run build:client && npm run build:server",
    "assets": "node scripts/copy-assets.mjs",
    "guides": "node scripts/build-guides.mjs",
    "guides:media": "node scripts/guide-media.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "vendor": "bash scripts/vendor-obelisk.sh && node scripts/copy-brand.mjs && node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@nostr-wot/blossom": "^0.2.0",
    "@nostr-wot/data": "^0.7.0",
    "@nostr-wot/dm": "^0.7.2",
    "@nostr-wot/relay": "^0.2.1",
    "@nostr-wot/signers": "^1.2.2",
    "@nostr-wot/ui": "file:vendor/nostr-wot-ui-0.8.3-obelisk.1.tgz",
    "@nostr-wot/wallet": "^0.4.3",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "mediasoup-client": "^3.24.5",
    "nostr-tools": "^2.23.0",
    "process": "^0.11.10",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-peer": "^9.11.1",
    "unist-util-visit": "^5.1.0",
    "vesta": "github:fchurca/vesta#semver:^0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/simple-peer": "^9.11.9",
    "@types/three": "^0.180.0",
    "esbuild": "^0.25.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.1.1",
    "marked": "^15.0.12",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "three": "^0.180.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
